ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FR=
# Real price of the ElevenLabs plan, to log the true cost of each video (default 0.22).
ELEVENLABS_USD_PER_1K_CHARS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
RESEND_API_KEY=

# Step 0 only: /api/probe answers 404 unless PROBE_ENABLED=1 (set it on the step 0
# preview only). If PROBE_TOKEN is set, calls must send it in the x-probe-token header.
PROBE_ENABLED=
PROBE_TOKEN=

# Local render: Chrome/Chromium binary for Remotion when it cannot download its own.
REMOTION_BROWSER_EXECUTABLE=
# Empty = Remotion Free License (company of up to 3 people). Company License key otherwise.
REMOTION_LICENSE_KEY=
